# ==============================================================
# Library Management System - Environment Configuration
# ==============================================================

# Option 1: Neon Cloud Database (PostgreSQL)
# --------------------------------------------------------------
# Paste your Neon connection strings here (from Neon console or `neon env pull`):
DATABASE_URL="postgresql://user:password@ep-sample-pooler.c-9.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.c-9.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Option 2: Local XAMPP Server (MySQL)
# --------------------------------------------------------------
# If running locally on XAMPP without Neon, you can set DB_CONNECTION=mysql:
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=library_db
# DB_USERNAME=root
# DB_PASSWORD=

# Base URL Configuration
# --------------------------------------------------------------
# Default for XAMPP (http://localhost/library-system/):
# BASE_URL=/library-system
# If running at web root or custom domain (e.g. http://localhost:8000/):
# BASE_URL=
