{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * .
	encode zstd gzip

	# Route any /library-system prefix to root files
	@library_prefix path /library-system /library-system/*
	handle @library_prefix {
		uri strip_prefix /library-system
		try_files {path} {path}/index.php /index.php
		php_server
	}

	try_files {path} {path}/index.php /index.php
	php_server
}
